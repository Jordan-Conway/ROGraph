<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ns="using:ROGraph.UI.Controls"
        x:Class="ROGraph.UI.Controls.DialogContainer">
    <ContentPresenter
        IsVisible="{Binding $parent[ns:DialogContainer].HasDialog}"
        Background="#40000000"
        IsHitTestVisible="{Binding $parent[ns:DialogContainer].HasDialog}"
        Content="{Binding $parent[ns:DialogContainer].DialogControl}"></ContentPresenter>
</UserControl>