<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ns="using:ROGraph.UI.Dialogs.TestDialog"
        x:Class="ROGraph.UI.Dialogs.TestDialog.TestDialog"
        x:Name="Root">
    <Grid RowDefinitions="*,*" ColumnDefinitions="*">
        <TextBlock
            Grid.Row="0">
            I am a test dialog
        </TextBlock>
        <Button Grid.Row="1" Command="{Binding #Root.CloseCommand}" CommandParameter="{Binding #Root.Result}">
            Close
        </Button>
    </Grid>
</UserControl>